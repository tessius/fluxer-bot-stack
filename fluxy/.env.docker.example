# cp .env.docker.example .env
# docker compose up -d --build

TOKEN=your_bot_token
OWNER_ID=your_user_id
PREFIX=!

API_ADMIN_TOKEN=change_me_long_random_string

DASHBOARD_URL=http://localhost:4000

# Self-hosted Fluxer: point at your own instance instead of fluxer.app
# FLUXER_INSTANCE_API=https://api.my-fluxer.example
# FLUXER_INSTANCE_GATEWAY=wss://gateway.my-fluxer.example
# FLUXER_INSTANCE_WEB=https://web.my-fluxer.example
# FLUXER_INSTANCE_MEDIA=https://cdn.my-fluxer.example

FLUXER_OAUTH_CLIENT_ID=
FLUXER_OAUTH_CLIENT_SECRET=
FLUXER_OAUTH_REDIRECT_URI=http://localhost:4000/auth/callback

# Dashboard build-time values. Keep these aligned with the Fluxer instance above.
VITE_FLUXER_INSTANCE_API=https://api.fluxer.app
VITE_FLUXER_INSTANCE_WEB=https://web.fluxer.app
VITE_FLUXER_INSTANCE_MEDIA=https://fluxerusercontent.com
VITE_FLUXER_CLIENT_ID=1474069931333816428
